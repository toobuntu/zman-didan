set -euo pipefail

# Reject any push that would introduce an unsigned or invalidly signed commit.
#
# git supplies one line per ref on stdin: "<local_ref> <local_oid> <remote_ref>
# <remote_oid>". Validate EVERY commit the push adds, not just the tip -- an
# unsigned commit buried under a signed tip would otherwise slip through, which
# is the whole point of the gate. For a ref update that is the
# remote_oid..local_oid range; for a brand-new ref (remote_oid all-zero) it is
# whatever local_oid reaches that is not already published (--not --remotes), so
# history already on the remote is not re-validated.
#
# %G? codes: G good, U good/unknown-signer, X expired key, Y expired cert (all
# accepted); N no signature; B/R/E bad/revoked/missing-key (rejected).
while read -r local_ref local_oid _ remote_oid; do
  # Skip ref deletions: a deletion's local OID is all-zero. Bash strips every
  # "0"; an all-zero OID leaves the empty string. Length-agnostic (SHA-1/256).
  [ -z "${local_oid//0/}" ] && continue

  # Precise range when we have remote_oid locally; otherwise (new ref, or an
  # unfetched remote tip) fall back to everything local_oid reaches that is not
  # already published. Scope "published" to the push destination ($1) when it
  # names a configured remote, so commits already on a DIFFERENT remote are
  # still validated; for a raw-URL push (no tracking refs) fall back to all.
  if [ -n "${remote_oid//0/}" ] && git cat-file -e "${remote_oid}^{commit}" 2>/dev/null; then
    range=("${remote_oid}..${local_oid}")
  elif git remote get-url "${1:-}" >/dev/null 2>&1; then
    range=("${local_oid}" --not "--remotes=$1")
  else
    range=("${local_oid}" --not --remotes)
  fi

  # Process substitution, not a pipe, so a rejection's `exit 1` leaves the hook
  # rather than just a subshell.
  while IFS= read -r oid; do
    case "$(git log -1 --format='%G?' "${oid}")" in
      G | U | X | Y) ;;
      N)
        echo "Push rejected: ${local_ref} adds unsigned commit ${oid}" >&2
        exit 1
        ;;
      *)
        echo "Push rejected: ${local_ref} adds an invalidly signed commit ${oid}" >&2
        exit 1
        ;;
    esac
  done < <(git rev-list "${range[@]}")
done
